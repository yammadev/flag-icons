{
  "name": "@yammadev/flag-icons",
  "version": "3.1.1",
  "description": "A beautiful svg + png + sass + css collection of 264 flags.",
  "main": "flags.json",
  "style": "css/flag-icons.css",
  "sass": "sass/flag-icons.scss",
  "files": [
    "css",
    "png",
    "sass",
    "svg",
    "flags.json"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && node scripts/build.mjs",
    "svg": "node scripts/svg.mjs",
    "png": "node scripts/png.mjs",
    "assets": "npm run svg && npm run png",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yammadev/flag-icons.git"
  },
  "keywords": [
    "flags",
    "flag-icons",
    "countries",
    "iso-3166",
    "svg",
    "png",
    "sass",
    "css",
    "icons"
  ],
  "author": {
    "name": "Yefferson Marín",
    "email": "yefferson.marin@gmail.com",
    "url": "https://github.com/yammadev"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yammadev/flag-icons/issues"
  },
  "homepage": "https://yammadev.github.io/flag-icons/",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "sass": "^1.106.1",
    "sharp": "^0.35.5",
    "svgo": "^3.3.5"
  }
}
